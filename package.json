{
  "name": "cthulhu",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone print server for the Elegoo Mars 5 Ultra resin printer, over SDCP",
  "license": "CC0-1.0",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2"
  }
}
