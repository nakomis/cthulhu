{
  "name": "@cthulhu/camera-service",
  "version": "0.0.0",
  "private": true,
  "description": "Turns the printer's RTSP camera into MJPEG over HTTP, off the box that runs cthulhu",
  "license": "CC0-1.0",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cthulhu/camera": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
