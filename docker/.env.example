# Real values are rendered from AWS SSM by Ansible at deploy time - never
# commit a populated .env. See CTHU-10.

# Pinned printer address. Leave blank to rely on UDP broadcast discovery,
# which requires the container to share Luke's subnet and use host networking.
PRINTER_IP=

DISCOVERY_ENABLED=true

# Pushover, for print-finished notifications (CTHU-9). SSM: /pushover/
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
